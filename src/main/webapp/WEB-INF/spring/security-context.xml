<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:security="http://www.springframework.org/schema/security"
    xsi:schemaLocation="http://www.springframework.org/schema/security http://www.springframework.org/schema/security/spring-security.xsd
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="bcryptPasswordEncoder"
        class="org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder" />

    <bean id="customLoginSuccessHandler"
        class="com.tripto.auth.CustomLoginSuccessHandler" />

    <security:http auto-config="true"
        use-expressions="true">
        <security:intercept-url
            pattern="/admin/**" access="hasRole('ROLE_ADMIN')" />
        <security:intercept-url
            pattern="/teamtwo/user/mypage.do" access="isAuthenticated()" />
        <security:intercept-url
            pattern="/teamtwo/chat/**" access="isAuthenticated()" />
        <security:intercept-url pattern="/**"
            access="permitAll" />

        <security:form-login
            login-page="/member/login.do" login-processing-url="/login"
            authentication-success-handler-ref="customLoginSuccessHandler"
            authentication-failure-url="/member/login.do?error=true"
            username-parameter="username" password-parameter="password" />

        <security:logout logout-url="/logout"
            logout-success-url="/index.do" invalidate-session="true" />
    </security:http>

    <security:authentication-manager>
        <security:authentication-provider>
            <!-- 
            users-by-username-query: 
            스프링 시큐리티가
            username, password, enabled(계정 활성화 여부 1 or 0) 
            이 세 개의 결과(Column)를 요구함
            -->
            <!-- 
            authorities-by-username-query:
            스프링 시큐리티가 username, authority(권한명) 
            두 개의 결과를 요구함
            -->
            <security:jdbc-user-service
                data-source-ref="dataSource"
                users-by-username-query="SELECT id AS username, pw AS password, CASE WHEN status = 0 THEN 1 ELSE 0 END AS enabled FROM member WHERE id = ?"
                authorities-by-username-query="SELECT id AS username, CASE WHEN type = 1 THEN 'ROLE_ADMIN' ELSE 'ROLE_MEMBER' END AS authority FROM member WHERE id = ?" />

            <security:password-encoder
                ref="bcryptPasswordEncoder" />
        </security:authentication-provider>
    </security:authentication-manager>
    
    

</beans>



